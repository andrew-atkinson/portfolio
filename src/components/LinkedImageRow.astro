---
import ImageRow from "@components/ImageRow.astro";
import { getEntries, getEntry } from "astro:content";

const { seriesName } = Astro.props;
const series = await getEntry("series", seriesName.toLowerCase() as any);

const pieces =
  series && series.data.pieces ? await getEntries(series.data.pieces) : [];
---

<a href={"/series/" + seriesName.toLowerCase()}>
  <ImageRow images={pieces} />
</a>
