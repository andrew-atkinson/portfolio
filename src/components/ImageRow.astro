---
import { Image } from "astro:assets";
const { images } = Astro.props;
---

<section class='animate'>
  <div class='flex flex-wrap justify-center gap-2 w-full'>
    {
      images.map((image: any) => (
        <div
          class='flex-shrink-0 max-h-100px'
          style={`width: min(calc((100% - ${images.length - 1} * 1rem) / ${images.length}), 200px);`}
        >
          <Image
            src={image.data.src}
            alt={image.data.alt}
            class='w-full h-auto object-contain'
            loading={"eager"}
            width={500}
            height={500}
          />
        </div>
      ))
    }
  </div>
</section>
