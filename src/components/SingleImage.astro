---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

const { id } = Astro.props;
const image: any = await getEntry("images", id.toLowerCase() as any);
---

<Image
  src={image.data.src}
  alt={image.data.alt}
  width='1200'
  height='1200'
  class='max-w-full max-h-[calc(100vh-10rem)] w-auto h-auto object-contain'
/>
