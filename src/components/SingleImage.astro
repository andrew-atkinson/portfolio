---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

const { imageName } = Astro.props;
const image: any = await getEntry("images", imageName.toLowerCase() as any);
---

<div class='mx-auto max-w-screen-lg'>
  <Image src={image.data.src} alt={image.data.alt} width='1000' height='1000' />
  <div id={image.data.title} class='text-base font-thin text-center'>
    <p>{image.data.title}</p>
  </div>
</div>
