---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

const { id } = Astro.props;
const image: any = await getEntry("images", id.toLowerCase() as any);
---

<section class='animate'>
  <Image
    src={image.data.src}
    alt={image.data.alt}
    width='1000'
    height='1000'
    class='p-0'
  />
</section>
