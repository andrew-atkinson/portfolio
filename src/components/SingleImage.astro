---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

const { frontmatter, id } = Astro.props;
const image: any = await getEntry("images", id.toLowerCase() as any);
---

<section class='animate'>
  <div
    class='relative bg-backlight dark:bg-backdark flex flex-wrap justify-center bg-slate-500/20'
  >
    <div class='px-5 mt-1'>
      <Image
        src={image.data.src}
        alt={image.data.alt}
        width='1000'
        height='1000'
      />
      <div id={image.data.title} class='font-thin text-center'>
        <p>{image.data.title}</p>
      </div>
    </div>
  </div>
</section>
