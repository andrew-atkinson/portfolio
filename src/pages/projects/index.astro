---
import { getCollection, type CollectionEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import { PROJECTS } from "@consts";
import ArrowCard from "@components/ArrowCard";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const series = await getCollection("series");
const panoramas = await getCollection("panoramas");
const images = await getCollection("images");

type ContentEntry = {
  collection: "projects" | "series" | "panoramas";
  data: any;
  slug: string;
};

const items: ContentEntry[] = [
  ...projects.map(
    (item) => ({ ...item, collection: "projects" }) as ContentEntry,
  ),
  ...series.map((item) => ({ ...item, collection: "series" }) as ContentEntry),
  ...panoramas.map(
    (item) => ({ ...item, collection: "panoramas" }) as ContentEntry,
  ),
];

const estimated_initial_size =
  28 + projects.length * 158 + (projects.length - 1) * 12;
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <TopLayout>
    <div class='animate'>
      <h1 class='text-3xl font-semibold text-black dark:text-white mt-2'>
        {PROJECTS.TITLE}
      </h1>
      <div class='mt-1'>
        {PROJECTS.DESCRIPTION}
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <div
      id='search-collection-wrapper'
      class='animate'
      style={{ minHeight: `${estimated_initial_size}px` }}
    >
      <ul class='flex flex-col gap-3'>
        <div class='text-xl font-semibold'>Projects</div>
        {
          items
            .filter((entry) => entry.collection === "projects")
            .map((entry) => {
              console.log("entry", entry);
              let thumbnail = images.filter(
                (img) => img.slug === entry.data.thumbnail,
              );
              return (
                <li>
                  <ArrowCard
                    entry={entry as CollectionEntry<"projects">}
                    pill={true}
                    getTagVisibility={() => true}
                    image={
                      thumbnail.length > 0 ? thumbnail[0].data.src.src : null
                    }
                  />
                </li>
              );
            })
        }
        <div class='text-xl font-semibold'>Series</div>
        {
          items
            .filter((entry) => entry.collection === "series")
            .map((entry) => {
              let thumbnail = images.filter(
                (img) => img.slug === entry.data.thumbnail,
              );
              return (
                <li>
                  <ArrowCard
                    entry={entry as CollectionEntry<"series">}
                    pill={true}
                    getTagVisibility={() => true}
                    image={
                      thumbnail.length > 0 ? thumbnail[0].data.src.src : null
                    }
                  />
                </li>
              );
            })
        }
      </ul>
    </div>
  </BottomLayout>
</PageLayout>
