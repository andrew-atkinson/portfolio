---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Search from "@components/Search";
import { SEARCH } from "@consts";

const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
const projects = (await getCollection("projects")).filter(
  (post) => !post.data.draft,
);
const tags = [
  ...new Set(projects.flatMap((project) => project.data.tags)),
].sort((a, b) => a.localeCompare(b));
const series = await getCollection("series");
const panoramas = await getCollection("panoramas");
const images = await getCollection("images");

const data = [
  ...posts,
  ...projects,
  ...series,
  ...panoramas,
  ...images,
] as CollectionEntry<"blog">[];
---

<PageLayout title={SEARCH.TITLE} description={SEARCH.DESCRIPTION}>
  <TopLayout>
    <div class='animate page-heading'>
      {SEARCH.TITLE}
    </div>
  </TopLayout>
  <BottomLayout>
    <div class='animate'>
      <Search client:load data={data} images={images} tags={tags} />
    </div>
  </BottomLayout>
</PageLayout>
