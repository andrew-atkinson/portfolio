---
import "@styles/global.css";
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Drawer from "@components/Drawer.astro";
import { SITE } from "@consts";
import Carousel from "@components/Carousel.astro";
import { getEntries, getEntry } from "astro:content";

const { frontmatter } = Astro.props;
const series: any = await getEntry("series", frontmatter.id);
const { Content } = await series.render();
const pieces = await getEntries(series.data.pieces);
---

<!doctype html>
<html lang='en'>
  <head>
    <BaseHead
      title={`${frontmatter.title} | ${SITE.TITLE}`}
      description={frontmatter.description}
    />
  </head>
  <body>
    <Header />
    <Drawer />
    <main>
      <section class='animate'>
        <div class='relative bg-backlight dark:bg-black'>
          <div class='mx-auto max-w-screen-lg p-5 space-y-24 pb-16'>
            <Carousel images={pieces} />
          </div>
        </div>
        <section class='animate'>
          <div class='relative bg-backlight dark:bg-black'>
            <div class='mx-auto max-w-screen-lg p-5 space-y-24 pb-16 text-base'>
              <Content />
            </div>
          </div>
        </section>
      </section>
      <Footer />
    </main>
  </body>
</html>
