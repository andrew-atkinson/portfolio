---
import "@styles/global.css";
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Drawer from "@components/Drawer.astro";
import { SITE } from "@consts";
import Carousel from "@components/Carousel.astro";
import { getEntries, getEntry } from "astro:content";
import ImageRow from "@components/ImageRow.astro";

const { frontmatter, id } = Astro.props;
const series: any = await getEntry("series", id);
const { Content } = await series.render();
const pieces = await getEntries(series.data.pieces);
const initialIndex = frontmatter?.initialIndex || 0;
---

<!doctype html>
<html lang='en'>
  <head>
    <BaseHead
      title={`${frontmatter.title} | ${SITE.TITLE}`}
      description={frontmatter.description}
    />
  </head>
  <body>
    <Header />
    <Drawer />
    <main>
      <Carousel
        images={pieces}
        initialIndex={initialIndex}
        frontmatter={frontmatter}
      />
      <section class='animate'>
        <div class='relative bg-backlight dark:bg-backdark'>
          <div class='mx-auto max-w-screen-lg p-5 pb-16 text-base'>
            <Content />
          </div>
        </div>
      </section>
      <ImageRow images={pieces} />
    </main>
    <Footer />
  </body>
</html>
