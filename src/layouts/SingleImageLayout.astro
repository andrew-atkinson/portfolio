---
import "@styles/global.css";
import SingleImage from "@components/SingleImage.astro";
import PageLayout from "@layouts/PageLayout.astro";

const { frontmatter, id } = Astro.props;
---

<PageLayout
  title={frontmatter.data.title}
  description={frontmatter.data.description}
>
  <section class='animate'>
    <div class='relative bg-backlight dark:bg-backdark'>
      <div
        class='mx-auto max-w-screen-lg mt-14 flex flex-col items-center px-5 pb-10'
      >
        <SingleImage image={frontmatter} id={id} frontmatter={frontmatter} />
        <div id={frontmatter.data.title} class='font-thin text-center mt-5'>
          <p>{frontmatter.data.title}</p>
          <p>{frontmatter.data.description}</p>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
